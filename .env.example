# Copy to .env and fill in. .env is git-ignored; .env.example is committed and
# must never contain real secrets.
#
# Every `change-me` below must be replaced.

# --- PostgreSQL container ----------------------------------------------------
POSTGRES_USER=health
POSTGRES_PASSWORD=change-me
POSTGRES_DB=health_tracker

# --- Application -------------------------------------------------------------
# Read by Prisma and the app.
#
# Host tooling (npm run dev, prisma migrate) connects over the loopback port
# published by docker compose:
DATABASE_URL=postgresql://health:change-me@localhost:5432/health_tracker
#
# The `app` container does not use this value - the compose files build their
# own DATABASE_URL pointing at the `db` service on the compose network.

# Origin the app is served from, exactly as users type it into the browser.
# Required in production - there is deliberately no fallback. State-changing
# requests from any other origin are refused.
#
# Development: http://localhost:3000
# Raspberry Pi: the LAN address, e.g. http://192.168.1.50:3000
APP_URL=http://localhost:3000

# --- Authentication: Firebase ------------------------------------------------
# Firebase Console -> your project.
#
# Web app config: Project settings -> General -> Your apps -> the Web app ->
# "SDK setup and configuration" -> Config. These three are public by design
# (they end up in every browser); they are read at run time, so changing them
# needs a restart, not a rebuild.
FIREBASE_API_KEY=change-me
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
#
# Service account: Project settings -> Service accounts -> "Generate new
# private key" downloads a JSON file. Copy two of its fields here and keep the
# file out of the repository (delete it once copied).
#
#   FIREBASE_CLIENT_EMAIL  <- "client_email"
#   FIREBASE_PRIVATE_KEY   <- "private_key", exactly as it appears in the JSON:
#                             one line, in double quotes, with the literal \n
#                             sequences kept (the app turns them back into line
#                             breaks).
#
# These two are SECRETS: whoever has them can manage every account.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nchange-me\n-----END PRIVATE KEY-----\n"
#
# Development only: point the app at the local Firebase Auth emulator instead
# of the real project. Leave unset (or empty) in production.
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
