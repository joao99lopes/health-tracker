# Copy to .env and fill in. .env is git-ignored; .env.example is committed and
# must never contain real secrets.
#
# Every `change-me` below must be replaced. The application refuses to start on
# a BETTER_AUTH_SECRET shorter than 32 characters, so that one cannot be left
# as it is by accident.

# --- PostgreSQL container ----------------------------------------------------
POSTGRES_USER=health
POSTGRES_PASSWORD=change-me
POSTGRES_DB=health_tracker

# --- Application -------------------------------------------------------------
# Read by Prisma and the app.
#
# Host tooling (npm run dev, prisma migrate) connects over the loopback port
# published by docker compose:
DATABASE_URL=postgresql://health:change-me@localhost:5432/health_tracker
#
# The `app` container does not use this value - docker-compose.yml builds its
# own DATABASE_URL pointing at the `db` service on the compose network.

# --- Backups -----------------------------------------------------------------
# Host directory the daily dumps are written to. Relative paths are resolved
# from this file's directory; /backups is ignored by git.
BACKUP_DIR=./backups
# How many days of dumps to keep. Older ones are deleted after each successful
# backup; the live database is never touched.
BACKUP_RETENTION_DAYS=30

# --- Authentication ----------------------------------------------------------
# Session cookie signing key. At least 32 characters; the app refuses to start
# below that. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Origin the app is served from, exactly as users type it into the browser.
# Required in production - there is deliberately no fallback, because a silent
# default to localhost would make every sign-in on the Pi fail as a
# cross-origin request.
#
# Development: http://localhost:3000
# Raspberry Pi: the LAN address, e.g. http://192.168.1.50:3000
BETTER_AUTH_URL=http://localhost:3000
