// Database schema.
//
// Numeric choices: every body metric is stored as `Decimal`, not `Float`.
// These are values a user reads off a scale and compares over time, so binary
// floating point rounding would be visible and wrong. `visceralFat` is a
// whole number as scales report it.
//
// BMI and the waist-to-height ratio are deliberately absent: they are derived
// from `weightKg` / `abdominalCircumferenceCm` and `heightCmAtMeasurement`.
// See CLAUDE.md.

generator client {
  provider = "prisma-client-js"
  // `native` resolves at generate time, so an amd64 development machine and an
  // arm64 Raspberry Pi each get the right query engine from their own build.
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  // The connection URL lives in prisma.config.ts (migrations) and in the
  // driver adapter in src/lib/db.ts (runtime). Prisma 7 no longer accepts it
  // here.
}

// ---------------------------------------------------------------------------
// Users
//
// Firebase Auth owns credentials, verification and password resets; nothing
// secret is stored here. A user row is the anchor for this app's data and is
// tied to a Firebase account by `firebaseUid`.
//
// Ids are strings rather than `@db.Uuid`: accounts created before Firebase
// carry ids generated by the previous auth library, which are not UUIDs, and
// every `userId` foreign key points at them. New rows get a UUID string.
// ---------------------------------------------------------------------------

model User {
  id String @id @default(uuid())

  /// Normalised (trimmed, lower-case). Unique, so one address is one user.
  email String @unique

  /// The Firebase Auth uid. Null only for accounts from before Firebase
  /// that have not signed in since; set on first sign-in with a verified
  /// address (see src/lib/auth/rules.ts).
  firebaseUid String? @unique

  /// Sessions whose sign-in predates this instant are refused - set when the
  /// password changes, so every other device is signed out. Null: no cut-off.
  sessionsValidAfter DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  profile      Profile?
  measurements Measurement[]
}

// ---------------------------------------------------------------------------
// Application data
// ---------------------------------------------------------------------------

enum Sex {
  FEMALE
  MALE
  OTHER
}

/// Supported interface languages. Adding one is additive: extend this enum and
/// the translation catalogue.
enum Language {
  EN
  PT
}

/// Which way the user would like a metric to move. A presentation preference
/// only: it carries no target and no recommendation, and nothing derived from
/// it is stored. See src/lib/preferences/direction.ts.
enum MetricDirection {
  DECREASE
  INDIFFERENT
  INCREASE
}

model Profile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique

  name      String?
  birthDate DateTime @db.Date
  sex       Sex
  /// The user's *current* height. Measurements keep their own copy, so
  /// changing this never alters historical BMI.
  heightCm  Decimal  @db.Decimal(5, 1)
  language  Language

  /// Direction preferences, one per metric, including the derived BMI and
  /// waist-to-height ratio. Only
  /// the current value is kept - no history of preference changes.
  weightKgDirection         MetricDirection @default(INDIFFERENT)
  bodyFatPercentDirection   MetricDirection @default(INDIFFERENT)
  hydrationPercentDirection MetricDirection @default(INDIFFERENT)
  musclePercentDirection    MetricDirection @default(INDIFFERENT)
  boneMassKgDirection       MetricDirection @default(INDIFFERENT)
  visceralFatDirection      MetricDirection @default(INDIFFERENT)
  bmiDirection              MetricDirection @default(INDIFFERENT)
  abdominalCircumferenceCmDirection MetricDirection @default(INDIFFERENT)
  waistToHeightRatioDirection       MetricDirection @default(INDIFFERENT)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Measurement {
  id     String @id @default(uuid()) @db.Uuid
  userId String

  measuredAt DateTime @db.Timestamptz(3)

  // All optional, but the application layer requires at least one of them to
  // be present. See src/lib/measurements/validation.ts.
  weightKg         Decimal? @db.Decimal(5, 2)
  bodyFatPercent   Decimal? @db.Decimal(4, 1)
  hydrationPercent Decimal? @db.Decimal(4, 1)
  musclePercent    Decimal? @db.Decimal(4, 1)
  boneMassKg       Decimal? @db.Decimal(4, 2)
  visceralFat      Int?
  /// Waist circumference, in cm.
  abdominalCircumferenceCm Decimal? @db.Decimal(4, 1)

  /// Height at the time of the measurement. Never updated afterwards - this is
  /// what keeps historical BMI and waist-to-height ratio stable when the
  /// profile height changes.
  heightCmAtMeasurement Decimal @db.Decimal(5, 1)

  /// Free text the user attaches to the reading ("after dinner"). Not a
  /// measurement value: it never satisfies the at-least-one-value rule.
  /// Length limit: NOTE_MAX_LENGTH in src/lib/measurements/fields.ts.
  note String? @db.VarChar(500)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Every read is scoped by userId and ordered by measuredAt; this composite
  // index serves both, and the leading column keeps per-user lookups cheap.
  @@index([userId, measuredAt])
}
