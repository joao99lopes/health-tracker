# Copy to deploy/ops/monitor.env on the Pi (git-ignored) and fill in.
#
# healthchecks.io ping URLs for this service only - create two free checks:
#   "health-tracker-backup"  period 1 day,  grace 2 h
#   "health-tracker-health"  period 5 min,  grace 10 min
# Empty = no alerts (the scripts still log locally).
HC_BACKUP_URL=
HC_CHECK_URL=

# Optional overrides (defaults shown).
# BACKUP_ROOT=$HOME/backups/health-tracker
# BACKUP_REMOTE=gdrive-crypt:impiza/health-tracker
# BACKUP_LOCAL_DAYS=7
# BACKUP_REMOTE_DAYS=30
# APP_HEALTH_URL=http://127.0.0.1:3000/api/health
